{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "agentgateway": {
      "name": "agentgateway",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://agw.noclues.net/v1",
        "apiKey": "{env:AGW_API_KEY}"
      },
      "models": {
        "openai/gpt-6-astra:api": {
          "name": "GPT-6 Astra"
        },
        "openai/gpt-6-sol:api": {
          "name": "GPT-6 Sol"
        },
        "openai/gpt-6.1-sol:api": {
          "name": "GPT-6.1 Sol"
        },
        "openai/gpt-6-luna:api": {
          "name": "GPT-6 Luna"
        },
        "openai/gpt-5.6-luna:api": {
          "name": "GPT-5.6 Luna"
        },
        "openai/gpt-5.6-sol:api": {
          "name": "GPT-5.6 Sol"
        },
        "openai/gpt-5.6-terra:api": {
          "name": "GPT-5.6 Terra"
        },
        "openai/gpt-5.4:api": {
          "name": "GPT-5.4"
        },
        "openai/gpt-5.4-mini:api": {
          "name": "GPT-5.4 Mini"
        },
        "openai/gpt-oss-120b:api": {
          "name": "GPT-OSS 120B"
        },
        "openai/gpt-6.1-terra:api": {
          "name": "GPT-6.1 Terra"
        },
        "openai/gemini-4-argon:api": {
          "name": "Gemini 4 Argon"
        }
      }
    }
  }
}
