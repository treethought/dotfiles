{
  "$schema": "https://charm.land/crush.json",
  "hooks": {
    "PreToolUse": [
      {
        "command": "$HOME/.config/crush/hooks/deny-dangerous.sh",
        "matcher": "^bash$",
        "name": "deny-dangerous"
      }
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "args": [
        "chrome-devtools-mcp@1.5.0"
      ],
      "command": "npx",
      "disabled": true,
      "type": "stdio"
    },
    "notion": {
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "command": "npx",
      "disabled": true,
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_API_KEY}\", \"Notion-Version\": \"2022-06-28\"}"
      },
      "type": "stdio"
    },
    "warpstream": {
      "oauth": true,
      "oauth_client_id": "warpstream-mcp",
      "type": "http",
      "url": "https://warpstream-mcp.noclues.net/mcp"
    }
  },
  "models": {
    "large": {
      "model": "glm-5.3:api",
      "provider": "agw-glm"
    },
    "small": {
      "model": "claude-haiku-4-5:api",
      "provider": "agw"
    }
  },
  "options": {
    "context_paths": [
      "/Users/treethought/.claude/CLAUDE.md",
      "CLAUDE.md",
      "CLAUDE.local.md"
    ]
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "glob",
      "sourcegraph",
      "fetch",
      "agent",
      "edit",
      "multiedit",
      "write",
      "mcp_warpstream_billing_chargebacks_get_past",
      "mcp_warpstream_billing_chargebacks_get_pending",
      "mcp_warpstream_billing_invoices_get_invoice_breakdowns",
      "mcp_warpstream_billing_invoices_get_past_invoice",
      "mcp_warpstream_billing_invoices_get_pending_invoice",
      "mcp_warpstream_billing_invoices_list",
      "mcp_warpstream_describe_client_metrics_subscription",
      "mcp_warpstream_describe_cluster_metrics",
      "mcp_warpstream_describe_events",
      "mcp_warpstream_describe_pipeline",
      "mcp_warpstream_describe_topic",
      "mcp_warpstream_describe_virtual_cluster",
      "mcp_warpstream_describe_virtual_cluster_configuration",
      "mcp_warpstream_describe_virtual_cluster_tags",
      "mcp_warpstream_diagnostics_status",
      "mcp_warpstream_events_query",
      "mcp_warpstream_get_agent_pool_details",
      "mcp_warpstream_get_events_state",
      "mcp_warpstream_get_virtual_cluster_size_hint",
      "mcp_warpstream_list_agent_pools",
      "mcp_warpstream_list_client_metrics_subscriptions",
      "mcp_warpstream_list_pipelines",
      "mcp_warpstream_list_topics",
      "mcp_warpstream_list_virtual_cluster_credentials",
      "mcp_warpstream_list_virtual_clusters",
      "mcp_warpstream_monitoring_describe_all_consumer_groups",
      "mcp_warpstream_monitoring_describe_quotas",
      "mcp_warpstream_virtual_clusters_acls_list",
      "bash"
    ]
  },
